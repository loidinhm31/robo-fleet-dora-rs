// Local native-Dora transport. Provisioned Docker deployments use the mTLS config.
{
  "mode": "peer",
  "listen": {
    "endpoints": ["tcp/0.0.0.0:7447"]
  },
  "transport": {
    "link": {
      "tx": {
        "lease": 10000,
        "keep_alive": 4,
        "batch_size": 65535
      }
    }
  },
  "scouting": {
    "multicast": {
      "enabled": true,
      "address": "224.0.0.224:7446",
      "interface": "auto"
    }
  }
}
