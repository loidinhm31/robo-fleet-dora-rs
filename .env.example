MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=
ALLOW_DEFAULT_CREDENTIALS=false
SESSION_TTL_SECONDS=3600
# Required for Rover bridge. Generate a unique secret per rover with at least
# 32 bytes (the example yields 32 bytes of entropy as a 64-character hex value).
# e.g. `openssl rand -hex 32`.
POWER_PROTECTED_WORK_HMAC_KEY=
# Required for Orchestra bridge: JSON map of every active rover ID to its
# matching Rover secret. The values must exactly match POWER_PROTECTED_WORK_HMAC_KEY.
# Example: {"rover-kiwi":"same-32-byte-minimum-secret"}
POWER_PROTECTED_WORK_HMAC_KEYS={}
