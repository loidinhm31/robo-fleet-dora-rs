# Orchestra environment overrides
# Copy to .env and set values, then: docker compose --profile orchestra up -d --build

# Auth credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# CORS: comma-separated list of allowed page origins (not the WSS server URL)
# The default includes the production domain; extend here if deploying elsewhere
# ALLOWED_ORIGINS=https://dms-study.cloud,http://localhost:1420,http://localhost:3000,http://localhost:5173

# Fleet config
# SELECTED_ENTITY_ID=rover-kiwi
# FLEET_ROSTER=rover-kiwi
