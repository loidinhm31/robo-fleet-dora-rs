# Orchestra environment overrides
# Copy to .env and set values, then: docker compose --profile orchestra up -d --build

# Authentication (MongoDB-based — see SETUP_ENVIRONMENT.md for MongoDB setup)
# Point to your MongoDB instance; for a local container, run a mongodb sidecar or use host.docker.internal
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=db
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=
# Set to true only for first-run bootstrap; disable immediately after seeding your admin user
ALLOW_DEFAULT_CREDENTIALS=false
SESSION_TTL_SECONDS=3600

# CORS: comma-separated list of allowed page origins (not the WSS server URL)
# The default includes the production domain; extend here if deploying elsewhere
# ALLOWED_ORIGINS=https://dms-study.cloud,http://localhost:1420,http://localhost:3000,http://localhost:5173

# Fleet config
# SELECTED_ENTITY_ID=rover-kiwi
# FLEET_ROSTER=rover-kiwi

# Recording storage (required for the orchestra profile; never use /home itself)
# HOST_RECORDING_PATH=/home/<host-user>/robo-fleet-recordings
# RECORDING_MAX_CONCURRENT=64
# RECORDING_MAX_DURATION_SECONDS=3600
# RECORDING_MAX_OUTPUT_BYTES=4294967296
# RECORDING_STARTUP_TIMEOUT_SECONDS=10
# RECORDING_FINALIZATION_TIMEOUT_SECONDS=15
# RECORDING_MIN_FREE_BYTES=1073741824
# RECORDING_QUEUE_CAPACITY=8
