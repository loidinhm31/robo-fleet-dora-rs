# =============================================================================
# Stage 1: Builder - Compile all Orchestra Rust binaries
# =============================================================================
FROM rust:1.88-bookworm AS builder

# Install build dependencies.
# `web_bridge` depends on `robo_rover_lib`, which enables Linux `cpal` device
# helpers; that transitive build graph requires ALSA headers in the builder.
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libasound2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install the Dora CLI version that matches the workspace node API.
RUN cargo install dora-cli --version 0.5.0 --locked

WORKDIR /build

# Copy platform-specific workspace Cargo.toml (orchestra members only)
COPY docker/Cargo.orchestra.toml Cargo.toml
COPY Cargo.lock ./

# Copy shared library Cargo.toml
COPY robo_rover_lib/Cargo.toml robo_rover_lib/
COPY common/lifecycle_manager/Cargo.toml common/lifecycle_manager/
COPY common/power-coordinator/Cargo.toml common/power-coordinator/
COPY common/resource_monitor/Cargo.toml common/resource_monitor/

# Copy orchestra node Cargo.toml files
COPY common/web_bridge/Cargo.toml common/web_bridge/
COPY orchestra/central_speech_recognizer/Cargo.toml orchestra/central_speech_recognizer/
COPY orchestra/command_parser/Cargo.toml orchestra/command_parser/
COPY orchestra/media_recorder/Cargo.toml orchestra/media_recorder/
COPY orchestra/recording_scheduler/Cargo.toml orchestra/recording_scheduler/
COPY orchestra/power-event-projector/Cargo.toml orchestra/power-event-projector/
COPY orchestra/zenoh_bridge/Cargo.toml orchestra/zenoh_bridge/

# Copy actual source code
COPY robo_rover_lib robo_rover_lib/
COPY common common/
COPY orchestra orchestra/

# Build all orchestra nodes
RUN cargo build --release \
    -p web_bridge \
    -p lifecycle_manager \
    -p power_coordinator \
    -p resource_monitor \
    -p central_speech_recognizer \
    -p command_parser \
    -p media_recorder \
    -p recording_scheduler \
    -p power_event_projector \
    -p orchestra_zenoh_bridge

# =============================================================================
# Stage 2: Runtime - Minimal image with only required binaries
# =============================================================================
FROM debian:bookworm-slim AS runtime

# Keep the runtime package version explicit. Override this build argument only
# when the Debian bookworm security repository publishes a newer vetted build.
ARG FFMPEG_DEBIAN_VERSION=7:5.1.9-0+deb12u1

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    "ffmpeg=${FFMPEG_DEBIAN_VERSION}" \
    libssl3 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Assert that the exact codecs and muxer used by the recorder are available in
# the image instead of discovering a broken encoder after deployment.
RUN set -eux; \
    ffmpeg -hide_banner -encoders 2>&1 | grep -Eq '[[:space:]]libx264[[:space:]]'; \
    ffmpeg -hide_banner -encoders 2>&1 | grep -Eq '[[:space:]]aac[[:space:]]'; \
    ffmpeg -hide_banner -muxers 2>&1 | grep -Eq '[[:space:]]E[[:space:]]mp4[[:space:]]'; \
    ffprobe -version >/dev/null

# Keep the image UID/GID stable so the documented host ownership survives a
# container replacement. The recording bind mount must be owned by 1000:1000.
RUN groupadd --gid 1000 dora && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash dora

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /build/target/release/web_bridge ./bin/
COPY --from=builder /build/target/release/lifecycle_manager ./bin/
COPY --from=builder /build/target/release/power_coordinator ./bin/
COPY --from=builder /build/target/release/resource_monitor ./bin/
COPY --from=builder /build/target/release/central_speech_recognizer ./bin/
COPY --from=builder /build/target/release/command_parser ./bin/
COPY --from=builder /build/target/release/media_recorder ./bin/
COPY --from=builder /build/target/release/recording_scheduler ./bin/
COPY --from=builder /build/target/release/power_event_projector ./bin/
COPY --from=builder /build/target/release/orchestra_zenoh_bridge ./bin/
COPY --from=builder /usr/local/cargo/bin/dora ./bin/

# Copy dataflow and config templates
COPY orchestra/orchestra-dataflow.yml ./dataflow/orchestra-dataflow.yml
COPY orchestra/zenoh_bridge/zenoh_config.json5 ./config/zenoh_config.json5
COPY models/scripts/model-manifest.sh ./scripts/model-manifest.sh
COPY docker/scripts/sherpa-stt-profile-files.sh ./scripts/sherpa-stt-profile-files.sh

# Create directories for models and runtime data. The marker makes an absent
# recording bind mount fail closed instead of silently writing to the image.
RUN mkdir -p /models/sherpa-onnx/asr && \
    mkdir -p /recordings && \
    mkdir -p /var/lib/robo-fleet/power-journal && \
    touch /recordings/.image-layer-recording-root-marker && \
    chown -R dora:dora /app /var/lib/robo-fleet

# Add entrypoint script
COPY docker/scripts/entrypoint-orchestra.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set PATH
ENV PATH="/app/bin:${PATH}"

# Expose ports
EXPOSE 3030 7447

USER dora

ENTRYPOINT ["/entrypoint.sh"]
